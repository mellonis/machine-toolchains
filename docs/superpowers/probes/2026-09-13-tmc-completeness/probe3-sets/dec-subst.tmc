? Variant F (fold): decimal arithmetic over a rich alphabet: blank, the ten digits, '+', '='.
? The digits are numeric literals so that a bound digit can be folded
? (`{d+1}`); a glyph-literal range `'0'..'8' as d` is `char-arithmetic`
? even though `'0'` and `0` name the same symbol (see dec-glyph.tmc).
alphabet dec { '_', 0..9, '+', '=' }

namespace decimal {
  ? Add one to the decimal number under the head. On entry the head is on
  ? any digit of the number; on exit it rests on the number's last digit.
  ? A carry out of the leftmost digit grows the number one cell left.
  export routine plusOne(tape num: dec) {
    entry state toEnd {
      [0..9] -> move [>] goto toEnd;
      [*]    -> move [<] goto inc;
    }
    state inc {
      [0..8 as d] -> write [{d+1}] goto toLast;
      [9]         -> write [0] move [<] goto inc;
      [*]         -> write [1] goto toLast;
    }
    state toLast {
      [0..9] -> move [>] goto toLast;
      [*]    -> move [<] return;
    }
  }

  ? Blank the leading zeros of the number under the head, keeping a lone
  ? zero. On entry the head is on any digit; on exit it rests on the
  ? first surviving digit.
  export routine stripLeadingZeros(tape num: dec writes { '_' }) {
    entry state toStart {
      [0..9] -> move [<] goto toStart;
      [*]    -> move [>] goto strip;
    }
    state strip {
      [0]    -> move [>] goto check;
      [*]    -> return;
    }
    state check {
      [1..9] -> move [<] goto blank;          // a digit follows: the zero was leading
      [0]    -> move [<] goto blank;
      [*]    -> move [<] return;              // the zero is the whole number
    }
    state blank {
      [0] -> write ['_'] move [>] goto strip;
    }
  }
}

machine {
  tape num: dec;
  entry state s     { [*] -> call decimal::plusOne(num = num) then strip; }
  state strip       { [*] -> call decimal::stripLeadingZeros(num = num) then done; }
  state done        { [*] -> stop; }
}
