? Violation 1: plusOne is called with the head on the number's LAST
? DIGIT instead of its '$' (the call in s1 skips goToEnd; the tape block
? places the head on cell 4). plusOne's body trusts its precondition.
// headlib.tmc is a separate compilation unit: every call is transparent (binds
// by index), and the alphabet is re-declared here with the SAME glyphs in the
// SAME order (docs/tmt/stdlib.md (calling a library routine)).
alphabet delSym { '_', '^', '$', '0', '1' }

machine {
  tape num: delSym;
  entry state s1 { [*] -> call del::plusOne()  then s2; }
  state s2       { [*] -> call del::goToStart() then s3; }
  state s3       { [*] -> call del::invert()   then stop; }
}
