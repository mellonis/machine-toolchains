# label;expected[;tags]
#
# The label is brainfuck source; the value is the bytes '.' emitted, comma
# separated. A `bytes` tape's index 0 IS its blank, so a genuine zero byte in
# the middle of the output would be dropped here — none of these emit one.
#
# The first three are the programs the repo's own derivation-first goldens
# use; the rest are the classics.

# three increments, printed
+++.;3
# the goldens' loop and skip cases
++[>+++<-]>.;6
[[+]+]++.;2
# 3 x 5 by repeated addition
+++[>+++++<-]>.;15
# 2 x 2 x 2 through nested loops
++[>++[>++<-]<-]>>.;8
# 8 x 8 + 1 = 65, which is 'A'
++++++++[>++++++++<-]>+.;65
# the canonical Hello World! — 72 101 108 108 111 32 87 111 114 108 100 33 10
++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.;72,101,108,108,111,32,87,111,114,108,100,33,10
# a space is a real symbol of the `ops` alphabet with no dispatch rule, so the
# interpreter gets an invalid-opcode fault for free — it traps, it does not halt
++ +.;trap
